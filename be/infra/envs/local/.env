DB_USERNAME=root
DB_PASSWORD=root_password
DB_HOST=localhost:3306
DB_NAME=mishis4x
ENV=local
# 1 is the seeded test/test user's ID (see be/db/seeds/001_users_seed.sql) -
# matches locally out of the box. A real deployment sets this to whichever
# users.id is actually allowed to see collection-tracker routes; see
# handlers.Data.CollectionOwnerUserID's doc comment for why this exists.
COLLECTION_OWNER_USER_ID=1
# Local-only convenience: lets any signed-up account see collection-tracker
# routes instead of just the one above, since nothing served locally is
# real eBay-sourced data. Deliberately NOT set in compose.yaml - see
# handlers.Data.CollectionAllowAllUsers's doc comment.
COLLECTION_ALLOW_ALL_USERS=true